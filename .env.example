# VITE_GEMINI_API_KEY: Required for Gemini AI API calls in the browser app.
# Copy this file to .env.local and set a valid key.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: comma-separated model fallback order.
# The app tries models left-to-right until one succeeds.
VITE_GEMINI_MODELS="gemini-3-flash-preview,gemini-2.5-flash"

# Optional: retry attempts per model for temporary high-load failures.
# Lower value is faster, higher value is more resilient. Recommended: 1-2.
VITE_GEMINI_MAX_RETRIES="2"

# Firebase client configuration.
# Copy this file to .env.local and fill values from your Firebase project settings.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
